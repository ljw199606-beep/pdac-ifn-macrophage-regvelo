# Copy to .env and set local paths before running full upstream analyses.
# Portable figure reproduction (scripts/reproduce_core_figures_portable.py) uses relative paths by default.
PDAC_PROJECT_ROOT=/path/to/pdac_regvelo_workspace
PDAC_RAW_DATA_DIR=/path/to/downloaded_public_datasets
PDAC_REGVELO_CKPT_DIR=/path/to/regvelo_models_csbj_hard
TORCH_FORCE_NO_WEIGHTS_ONLY_LOAD=1
OPENBLAS_NUM_THREADS=1
OMP_NUM_THREADS=1
